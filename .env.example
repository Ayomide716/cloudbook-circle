# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# The "anon" / "publishable" key. It is public by design; row-level security protects your data.
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# Public URL of your deployed site (used for link previews / SEO tags), without a trailing slash.
VITE_SITE_URL="https://your-domain.com"

# Optional: GIF search in chat. Get keys from https://developers.google.com/tenor and https://developers.giphy.com
VITE_TENOR_API_KEY=""
VITE_GIPHY_API_KEY=""
